{
	"name": "comix-sense",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "^22.17.0 || >=24.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"test": "playwright test",
