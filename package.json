{
	"name": "comix-sense",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "^22.17.0 || >=24.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "node tools/prepare-archive-codecs.mjs && svelte-kit sync",
		"test": "playwright test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"predev": "node tools/prepare-archive-codecs.mjs",
		"prebuild": "node tools/prepare-archive-codecs.mjs",
		"evaluate:merge": "node --import ./tools/merge-eval/register.mjs tools/merge-eval/cli.mjs",
		"test:merge-eval": "node --import ./tools/merge-eval/register.mjs --test tools/merge-eval/*.test.mjs",
		"test:vision-pilot": "node --import ./tools/merge-eval/register.mjs --test tools/vision-pilot/*.test.mjs",
		"replay:vision-pilot": "node --import ./tools/merge-eval/register.mjs tools/vision-pilot/run.mjs",
		"rehearse:vision-pilot": "node --import ./tools/merge-eval/register.mjs tools/vision-pilot/demo.mjs",
		"source:vision-pilot": "node --import ./tools/merge-eval/register.mjs tools/vision-pilot/source-run.mjs",
		"diagnose:vision-pilot-source": "node tools/vision-pilot/source-diagnostic.mjs",
		"review:vision-artifacts": "node tools/vision-pilot/artifact-review.mjs"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.20.5",
		"@types/wicg-file-system-access": "^2023.10.7",
		"carbon-components-svelte": "^0.113.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^7.0.0",
		"vite": "^8.3.4"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fortawesome/free-solid-svg-icons": "^7.3.1",
		"@zip.js/zip.js": "2.24.0",
		"libarchive.js": "2.0.2",
		"svelte-flagpack": "^1.0.0"
	}
}
