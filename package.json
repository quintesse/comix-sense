		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^5.9.3",
		"vite": "^8.3.4"
	},
	"engines": {
		"node": "^22.12.0 || >=24.0.0"
	}
}
