		"@types/wicg-file-system-access": "^2023.10.7",
		"carbon-components-svelte": "^0.113.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.0",
		"vite": "^8.3.4"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fortawesome/free-solid-svg-icons": "^7.3.1"
